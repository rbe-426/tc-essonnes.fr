{
  "name": "tce-photos-backend",
  "version": "1.0.0",
  "description": "Backend API pour TCE Photos",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typeorm": "typeorm",
    "migration:generate": "typeorm migration:generate",
